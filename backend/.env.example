# =====================================================================
# Configuracion del backend Rayos Cosmicos
# Copiar este archivo como .env y ajustar los valores
# =====================================================================

# --- Aplicacion ---
APP_NAME=Rayos Cosmicos Backend
APP_VERSION=1.0.0
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rayos_cosmicos
DB_USER=postgres
DB_PASSWORD=123456
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000

# --- Sesiones (login basico) ---
# Duracion de cada sesion en horas
SESSION_DURATION_HOURS=8

# --- CORS (URL del frontend Vue + Vite) ---
CORS_ORIGIN=http://localhost:5173

# --- Logs y archivos ---
LOG_LEVEL=info
UPLOAD_DIR=./uploads
LOG_DIR=./logs

# --- Streaming ---
HEARTBEAT_INTERVAL=30000
EVENT_BUFFER_SIZE=200
